<?php

/**
 * @file
 * Functions to support theming.
 */

use Drupal\node\NodeInterface;

/**
 * Implements hook_preprocess_html().
 *
 * Attaches page-only libraries (its/page.*) by node bundle
 * (beautiful_page, service_status) or by request path prefix.
 */
function its_preprocess_html(array &$variables): void {
  $allowed_schemes = [
    'teal_coral',
    'forest_amber',
    'slate_terracotta',
    'plum_sage',
  ];
  $color_scheme = theme_get_setting('color_scheme') ?? 'slate_terracotta';
  if (!in_array($color_scheme, $allowed_schemes, TRUE)) {
    $color_scheme = 'slate_terracotta';
  }
  $variables['html_attributes']['data-its-scheme'] = $color_scheme;

  $node = \Drupal::routeMatch()->getParameter('node');
  if (is_numeric($node)) {
    $node = \Drupal\node\Entity\Node::load($node);
  }
  if ($node instanceof NodeInterface) {
    if ($node->bundle() === 'beautiful_page') {
      $variables['#attached']['library'][] = 'its/page.beautiful';
    }
    if ($node->bundle() === 'service_status') {
      $variables['#attached']['library'][] = 'its/page.service-status';
    }
  }

  $current = \Drupal::request()->getPathInfo();

  $path_libraries = [
    '/contact' => 'its/page.contact',
    '/careers' => 'its/page.careers',
    '/software-licensing-deployment' => 'its/page.software-licensing',
    '/whats-new' => 'its/page.whats-new',
    '/startup' => 'its/page.startup',
    '/artificial-intelligence' => 'its/page.tabbed',
    '/service-status-dashboard' => 'its/page.service-status',
    '/individual-reflection' => 'its/page.custom-modules',
  ];

  foreach ($path_libraries as $prefix => $library) {
    if ($current === $prefix || str_starts_with($current, $prefix . '/')) {
      $variables['#attached']['library'][] = $library;
    }
  }
}

/**
 * Implements hook_preprocess_image_widget().
 */
function its_preprocess_image_widget(array &$variables) {
  $data = &$variables['data'];

  // This prevents image widget templates from rendering preview container HTML
  // to users that do not have permission to access these previews.
  // @todo revisit in https://drupal.org/node/953034
  // @todo revisit in https://drupal.org/node/3114318
  if (isset($data['preview']['#access']) && $data['preview']['#access'] === FALSE) {
    unset($data['preview']);
  }
}

/**
 * Implements hook_library_info_alter().
 *
 * background_image still declares core/underscore, which was removed in
 * Drupal 10.3+. Remap to core/internal.underscore so RuntimeCss can call
 * _.extend without a console TypeError.
 */
function its_library_info_alter(array &$libraries, string $extension): void {
  if ($extension !== 'background_image' || !isset($libraries['runtime.css']['dependencies'])) {
    return;
  }
  foreach ($libraries['runtime.css']['dependencies'] as &$dependency) {
    if ($dependency === 'core/underscore') {
      $dependency = 'core/internal.underscore';
    }
  }
}
