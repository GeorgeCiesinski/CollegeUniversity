{
  "name": "its-theme",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Frontend build for the ITS Drupal theme.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:overrides",
    "build:overrides": "sass src/scss/layout/slick-module.scss:overrides/slick-module.css src/scss/theme/slick-theme.scss:overrides/slick-theme.css --no-source-map --style=expanded",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "check": "npm run format && npm run lint",
    "check:fix": "npm run format:fix && npm run lint:fix",
    "validate": "npm run check && npm test"
  },
  "devDependencies": {
    "@drupal/once": "^1.0.1",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "jquery": "^3.7.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "sass": "^1.90.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
