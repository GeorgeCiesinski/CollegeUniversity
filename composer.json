        "drupal/linkit": "^7.0",
        "drupal/material_icons": "^2.0",
        "drupal/menu_block": "^1.10",
        "drupal/message_banner": "^2.0",
        "drupal/metatag": "^2.2",
        "drupal/pathauto": "^1.11",
        "drupal/search_api_autocomplete": "^1.9",
        "drupal/slick": "^3.0",
        "drupal/slick_extras": "^2.0",
        "drupal/slick_views": "^3.0",
        "drupal/smart_date": "^4.0",
        "drupal/svg_image": "^3.0",
        "drupal/token_block": "^2.0",
        "drupal/vite": "^1.5",
        "drupal/webform": "^6.3",
        "drush/drush": "^13",
        "jquery/chosen": "1.8.7",
        "jquery/hotkeys": "0.2.0",
        "jquery/image-picker": "0.3.1",
        "jquery/inputmask": "5.0.9",
        "jquery/intl-tel-input": "17.0.19",
        "jquery/rateit": "1.1.5",
        "jquery/select2": "4.0.13",
        "jquery/textcounter": "0.9.1",
        "jquery/timepicker": "1.14.0",
        "kenwheeler/slick": "1.8.1",
        "pantheon-systems/drupal-integrations": "^10",
        "popperjs/popperjs": "2.11.6",
        "progress-tracker/progress-tracker": "2.0.7",
        "signature_pad/signature_pad": "2.3.0",
        "svg-pan-zoom/svg-pan-zoom": "3.6.1",
        "tabby/tabby": "12.0.3",
        "tippyjs/tippyjs": "6.3.7"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "cweagans/composer-patches": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/sites/example.settings.local.php": false,
                "[project-root]/.editorconfig": false,
                "[project-root]/.gitattributes": false,
                "[project-root]/pantheon.upstream.yml": false
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "web/private/scripts/quicksilver/{$name}/": [
                "type:quicksilver-script"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "patches": {}
    }
}
