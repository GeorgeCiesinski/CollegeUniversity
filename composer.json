        "drupal/core-project-message": "^10.1",
        "drupal/core-recommended": "^10.1",
        "drupal/devel": "^5.3",
        "drupal/easy_breadcrumb": "^2.0",
        "drupal/editor_advanced_link": "^2.2",
        "drupal/extlink": "^1.7",
        "drupal/focal_point": "^2.1",
        "drupal/fullcalendar_view": "^5.1",
        "drupal/gin": "^4.1.4",
        "drupal/gin_toolbar": "^2.0",
        "drupal/honeypot": "^2.2",
        "drupal/iframe": "^3.0",
